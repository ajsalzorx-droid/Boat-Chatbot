{
  "name": "whatsapp-chatbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "secret": "node scripts/generate-secret.mjs",
    "db:sync-indexes": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/sync-indexes.ts",
    "check:setup": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/check-setup.ts",
    "admin:create": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/create-admin.ts",
    "webhook:simulate": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/simulate-webhook.ts",
    "whatsapp:send-test": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/send-test-message.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@upstash/qstash": "2.12.0",
    "mongoose": "9.11.2",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "mongodb-memory-server": "11.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
