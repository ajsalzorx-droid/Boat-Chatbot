# =============================================================================================
# WhatsApp Chatbot Platform: environment variables
#
# Copy to `.env.local` for local development. In production, set these in the hosting
# provider's encrypted environment settings (e.g. Vercel → Project → Settings → Environment
# Variables). NEVER commit real values.
#
# Generate every secret with:   npm run secret
# Use a DIFFERENT value per variable and per environment (development / preview / production).
# Placeholder-looking values (e.g. "change-me", "example") are rejected when NODE_ENV=production.
# =============================================================================================

# --- Runtime --------------------------------------------------------------------------------
# debug | info | warn | error (default: info in production, debug otherwise)
LOG_LEVEL=warn

# --- MongoDB Atlas (required) ---------------------------------------------------------------
# Use a least-privilege database user (readWrite on this database only).
# Example shape: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Optional: database name if not included in the URI path.
MONGODB_DB_NAME=

# --- Company website database (optional, read only) ------------------------------------------
# When set, the bot reads products, daily catch and offers live from the website's MongoDB
# (collections menu_items, daily_catch, offers). Use a database user with read-only access.
WEBSITE_DB_URI=
# Database name inside that cluster. Default: boat
WEBSITE_DB_NAME=

# --- Meta WhatsApp Cloud API (required for messaging) ---------------------------------------
# System-user access token with whatsapp_business_messaging (+ whatsapp_business_management).
# Do NOT use the 24-hour temporary token from the API Setup page in production.
WHATSAPP_ACCESS_TOKEN=
# Numeric IDs from WhatsApp Manager / the app's WhatsApp → API Setup page.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Random string (min 32 chars) you also paste into the Meta webhook configuration.
WHATSAPP_VERIFY_TOKEN=
# App Dashboard → App settings → Basic → App secret. Used to verify X-Hub-Signature-256.
META_APP_SECRET=
# Graph API version, e.g. v25.0. Check Meta's changelog before upgrading.
WHATSAPP_API_VERSION=

# --- Embedded Signup / coexistence (optional) -----------------------------------------------
# Only needed to connect a number that stays in the WhatsApp Business app (docs/deployment.md 1.7).
# App Dashboard → App ID, and Facebook Login for Business → Configurations → configuration ID.
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=

# --- Admin authentication (required for the dashboard) --------------------------------------
# Min 32 chars. Rotating it invalidates every admin session.
ADMIN_SESSION_SECRET=
# Session lifetime in hours (1–168). Default 12.
ADMIN_SESSION_TTL_HOURS=

# --- AI provider (optional) -----------------------------------------------------------------
# none | anthropic | gemini. With "none" (or missing key/model) the bot answers from FAQs,
# products, business details and rules only.
AI_PROVIDER=none
# Anthropic: console.anthropic.com → API Keys. Gemini: aistudio.google.com → Get API key.
AI_PROVIDER_API_KEY=
# Model ID for the selected provider, e.g. claude-haiku-5-5 or gemini-3.5-flash-lite
AI_MODEL=
# Per-request timeout in milliseconds (1000–60000). Default 12000.
AI_TIMEOUT_MS=

# --- Durable queue: Upstash QStash (strongly recommended in production) --------------------
# Leave all QSTASH_* empty to use the inline queue (fine for local development): jobs are
# still stored in MongoDB first and recovered by the cron sweep.
# Public HTTPS base URL of this deployment (QStash calls <APP_BASE_URL>/api/jobs/process).
APP_BASE_URL=
# Upstash Console → QStash → Request builder / Signing keys.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional: regional QStash endpoint if your Upstash account uses one.
QSTASH_URL=
# Optional: max jobs processed at once (default 20). Raise it with your Anthropic rate limit and
# MongoDB Atlas tier.
QSTASH_PARALLELISM=

# --- Scheduled recovery (Vercel Cron, see vercel.json) -------------------------------------
# Min 32 chars. Vercel sends it as "Authorization: Bearer <CRON_SECRET>" to /api/cron/recover.
CRON_SECRET=

# --- Demo simulator ---------------------------------------------------------------------------
# true | false. Default: on in development, off in production. Simulated chats never reach WhatsApp.
SIMULATOR_ENABLED=
